# core
ENV=local
DEBUG=true
LOG_FORMAT=text
# db
# The API runs in the compose stack, so the host is the database container, not
# localhost. Point this at localhost:5430 only when running uvicorn directly.
DB_ENGINE=tortoise.backends.asyncpg
DB_HOST=db-anydm-api
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=db-anydm
# cors: comma-separated origins; leave empty for same-origin only
CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030
# Required on every route but /health/check when set. Empty leaves the API open.
API_KEY=
# public URL of this service
PUBLIC_BASE_URL=http://127.0.0.1:8030
# download
# Where finished files land. The compose stack mounts a named volume here, so a
# path inside the workdir is what survives a container rebuild.
DOWNLOAD_DIR=./download
DOWNLOAD_WORKERS=2
# 64 KiB, not 1 MiB. Segmentation did not retire this constraint the way it
# looked like it would: the writer's flush timer only fires when a write
# arrives, and a write arrives once per chunk, so the chunk size still sets how
# often progress can move. At 1 MiB a slow segment freezes the bar for seconds
# at a time. Throughput does not need a big chunk — DOWNLOAD_WRITE_BUFFER_BYTES
# is what coalesces the actual disk writes.
DOWNLOAD_CHUNK_SIZE=65536
# Concurrent range requests per part. 1 disables segmentation entirely, which is
# also the rollback switch.
DOWNLOAD_SEGMENTS=4
# 16 MiB. Below this, the extra round trips cost more than the concurrency wins.
DOWNLOAD_SEGMENT_MIN_BYTES=16777216
# 4 MiB buffered before a positional write. Paired with a 500 ms timer so a slow
# link still reports progress.
DOWNLOAD_WRITE_BUFFER_BYTES=4194304
DOWNLOAD_PROGRESS_FLUSH_MS=1000
# Total tries per task, the first attempt included.
DOWNLOAD_MAX_ATTEMPTS=3
DOWNLOAD_RATE_LIMIT_BPS=0
# Free space the download disk must keep (1 GiB). Below it, new downloads are
# refused with 507 and queued ones wait. 0 turns the guard off.
DOWNLOAD_MIN_FREE_BYTES=1073741824
# torrent
TORRENT_ENABLED=true
TORRENT_API_URL=http://torrent-anydm-api:3030
TORRENT_DIR=./download/torrent
TORRENT_POLL_MS=1000
TORRENT_METADATA_TIMEOUT_S=30
TORRENT_REQUEST_TIMEOUT_S=10
TORRENT_DOWNLOAD_LIMIT_BPS=0
TORRENT_UPLOAD_LIMIT_BPS=0
# media
# ffmpeg executable; YouTube downloads merge separate video and audio streams with it.
FFMPEG_PATH=ffmpeg
