# core
ENV=local
DEBUG=true
LOG_FORMAT=text
# db
# The API runs in the compose stack, so the host is the database container, not
# localhost. Point this at localhost:5430 only when running uvicorn directly.
DB_ENGINE=tortoise.backends.asyncpg
DB_HOST=db-anydm-api
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=db-anydm
# cors: comma-separated origins; leave empty for same-origin only
CORS_ORIGINS=http://localhost:3030,http://127.0.0.1:3030
# public URL of this service
PUBLIC_BASE_URL=http://127.0.0.1:8030
# download
# Where finished files land. The compose stack mounts a named volume here, so a
# path inside the workdir is what survives a container rebuild.
DOWNLOAD_DIR=./download
DOWNLOAD_WORKERS=2
# 1 MiB. This used to be 64 KiB so progress could be sampled once per chunk;
# sampling is now per-segment on its own timer, so the chunk has no progress job
# left and can be sized for throughput.
DOWNLOAD_CHUNK_SIZE=1048576
# Concurrent range requests per part. 1 disables segmentation entirely, which is
# also the rollback switch.
DOWNLOAD_SEGMENTS=4
# 16 MiB. Below this, the extra round trips cost more than the concurrency wins.
DOWNLOAD_SEGMENT_MIN_BYTES=16777216
# 4 MiB buffered before a positional write. Paired with a 500 ms timer so a slow
# link still reports progress.
DOWNLOAD_WRITE_BUFFER_BYTES=4194304
DOWNLOAD_PROGRESS_FLUSH_MS=1000
# Total tries per task, the first attempt included.
DOWNLOAD_MAX_ATTEMPTS=3
# media
# ffmpeg executable; YouTube downloads merge separate video and audio streams with it.
FFMPEG_PATH=ffmpeg
