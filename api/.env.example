# core
ENV=local
DEBUG=true
LOG_FORMAT=text
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# db
# The API runs in the compose stack, so the host is the service name, not
# localhost. Point this at localhost:5403 only when running uvicorn directly.
DB_SCHEMA=postgresql
DB_HOST=db
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=anydm
# downloads
DOWNLOADS_DIR=./downloads
DOWNLOAD_WORKERS=2
# 64 KiB, not 1 MiB: progress can only be sampled once per chunk, so a large
# chunk starves the progress feed on a slow link. PROGRESS_FLUSH_MS is what
# protects the database, not the chunk size.
DOWNLOAD_CHUNK_SIZE=65536
PROGRESS_FLUSH_MS=1000
MAX_ATTEMPTS=3
FFMPEG_PATH=ffmpeg
