        {
            "name": "confirm-of-a-signed-add-without-a-signature",
            "given": [
                "signed-add-done"
            ],
            "request": {
                "path": "/confirm",
                "body": {
                    "token": "$token"
                }
            },
            "answer": "unknown-token"
