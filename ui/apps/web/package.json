{
    "name": "web",
    "type": "module",
    "private": true,
    "version": "0.0.1",
    "description": "AnyDM UI",
    "scripts": {
        "clean": "rm -rf dist && rm -rf node_modules",
        "format": "bunx prettier . --write",
        "format.check": "bunx prettier --check .",
        "check": "bunx tsc --noEmit",
        "test": "bun test",
        "dev": "bunx vite",
        "build": "bunx tsc --noEmit && bunx vite build"
    },
    "dependencies": {
        "@icons-pack/react-simple-icons": "13.15.1",
        "chart.js": "4.5.1",
        "class-variance-authority": "0.7.1",
        "hls.js": "1.7.3",
        "lucide-react": "1.54.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router-dom": "7.18.4"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.3.3",
        "@types/bun": "1.4.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "prettier": "3.9.9",
        "prettier-plugin-multiline-arrays": "4.1.11",
        "prettier-plugin-tailwindcss": "0.8.1",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.4"
    }
}
