{
    "name": "web",
    "type": "module",
    "private": true,
    "version": "0.0.1",
    "description": "AnyDM UI",
    "scripts": {
        "clean": "rm -rf dist && rm -rf node_modules",
        "fmt": "bunx prettier . --write",
        "fmt.chk": "bunx prettier --check .",
        "chk": "bunx tsc --noEmit",
        "dev": "bunx vite --mode ssr",
        "build": "bunx vite build"
    },
    "dependencies": {
        "@qwik.dev/core": "^2.0.0-beta.38",
        "@qwik.dev/router": "^2.0.0-beta.38",
        "@qwik-ui/headless": "^0.7.4",
        "@qwik-ui/utils": "^0.3.3",
        "class-variance-authority": "^0.7.1",
        "qwikset-icons-v2": "^0.1.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.3.3",
        "@types/bun": "1.3.14",
        "prettier": "3.9.6",
        "prettier-plugin-multiline-arrays": "4.1.11",
        "prettier-plugin-tailwindcss": "0.8.1",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "typescript-plugin-css-modules": "5.2.0",
        "vite": "8.2.0"
    }
}
