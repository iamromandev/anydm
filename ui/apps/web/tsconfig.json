{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "lib": [
            "ESNext",
            "DOM",
            "WebWorker",
            "DOM.Iterable"
        ],
        "moduleResolution": "bundler",
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "incremental": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "noEmit": true,
        "outDir": "dist",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@/component/core/*": [
                "./src/component/core/*"
            ],
            "@/component/shared/*": [
                "./src/component/shared/*"
            ],
            "@/component/layouts/*": [
                "./src/component/layouts/*"
            ],
            "@/component/features/*": [
                "./src/component/features/*"
            ]
        },
        "types": [
            "bun"
        ]
    },
    "include": [
        "src",
        "./*.d.ts",
        "./*.config.ts"
    ],
    "exclude": [
        "node_modules",
        "src/component/layouts/app-shell",
        "src/component/features/add-torrent-modal",
        "src/component/features/batch-modal",
        "src/component/features/group-card",
        "src/component/features/hero-input",
        "src/component/features/player-modal",
        "src/component/features/playlist-picker",
        "src/component/features/search-view",
        "src/component/features/torrent-card",
        "src/component/features/torrent-list",
        "src/route/index.tsx"
    ]
}
