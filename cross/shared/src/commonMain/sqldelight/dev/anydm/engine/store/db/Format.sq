import dev.anydm.engine.core.AudioFormat;
import dev.anydm.engine.core.Container;
import dev.anydm.engine.core.DownloadId;
import dev.anydm.engine.core.HdrChoice;
import dev.anydm.engine.core.QualityPreset;
import kotlin.Int;

-- What the user wants from a media page (MED-09 to MED-11): dev.anydm.engine.core.Format. At most one row per download,
-- gone with it.
CREATE TABLE format (
    download_id INTEGER AS DownloadId NOT NULL PRIMARY KEY REFERENCES download(id) ON DELETE CASCADE,
    preset TEXT AS QualityPreset NOT NULL,
    height INTEGER AS Int,
    fps INTEGER AS Int,
    hdr TEXT AS HdrChoice,
    video_codec TEXT,
    audio_codec TEXT,
    audio_only TEXT AS AudioFormat,
    container TEXT AS Container
);

put:
INSERT OR REPLACE INTO format(download_id, preset, height, fps, hdr, video_codec, audio_codec, audio_only, container)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectByDownload:
SELECT * FROM format WHERE download_id = ?;
