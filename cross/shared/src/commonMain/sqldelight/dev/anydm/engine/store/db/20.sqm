-- Version 20 to 21 (#543): proxies (NET-15), and the proxy a download or a profile asks for.
CREATE TABLE proxy (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    type TEXT NOT NULL,
    host TEXT NOT NULL,
    port INTEGER NOT NULL CHECK (port BETWEEN 1 AND 65535),
    username TEXT,
    bypass TEXT NOT NULL DEFAULT ''
);
ALTER TABLE download ADD COLUMN proxy TEXT NOT NULL DEFAULT 'INHERIT';
ALTER TABLE profile ADD COLUMN proxy TEXT NOT NULL DEFAULT 'INHERIT';
