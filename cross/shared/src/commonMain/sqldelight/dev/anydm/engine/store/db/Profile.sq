import dev.anydm.engine.core.CategoryId;
import dev.anydm.engine.core.ProfileId;
import dev.anydm.engine.net.ProxyChoice;

-- A named bundle of download options (SET-02), read live by the jobs that name it. `format` is the Format as JSON.
-- download.profile_id has no foreign key (SQLite can't add one to an existing column): ProfileStore.delete clears it.
CREATE TABLE profile (
    id INTEGER AS ProfileId PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    format TEXT,
    category_id INTEGER AS CategoryId,
    save_folder TEXT,
    name_template TEXT,
    speed_limit INTEGER CHECK (speed_limit > 0),
    -- Which proxy its downloads go through (NET-15): ProxyChoice.encode.
    proxy TEXT AS ProxyChoice NOT NULL DEFAULT 'INHERIT'
);

selectAll:
SELECT * FROM profile ORDER BY name;

selectById:
SELECT * FROM profile WHERE id = ?;

selectByName:
SELECT * FROM profile WHERE name = ?;

selectLastInserted:
SELECT * FROM profile WHERE id = last_insert_rowid();

insert:
INSERT INTO profile(name, format, category_id, save_folder, name_template, speed_limit, proxy) VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE profile SET name = ?, format = ?, category_id = ?, save_folder = ?, name_template = ?, speed_limit = ?, proxy = ? WHERE id = ?;

delete:
DELETE FROM profile WHERE id = ?;

countJobs:
SELECT count(*) FROM download WHERE profile_id = ?;

clearJobs:
UPDATE download SET profile_id = NULL WHERE profile_id = ?;

countProxy:
SELECT count(*) FROM profile WHERE proxy = ?;
