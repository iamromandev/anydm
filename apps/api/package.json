{
    "name": "api",
    "type": "module",
    "private": true,
    "version": "0.0.1",
    "description": "AnyDM API",
    "scripts": {
        "clean": "rm -rf dist && rm -rf node_modules",
        "fmt": "bunx prettier . --write",
        "fmt.chk": "bunx prettier --check .",
        "chk": "bunx tsc --noEmit",
        "dev": "bun --hot src/index.ts"
    },
    "dependencies": {
        "ffmpeg-static": "5.3.0",
        "hono": "4.13.0",
        "rqbit-napi": "1.0.2",
        "youtubei.js": "17.2.0"
    },
    "devDependencies": {
        "@types/bun": "1.3.14",
        "prettier": "3.9.6",
        "typescript": "7.0.2",
        "prettier-plugin-multiline-arrays": "4.1.11"
    }
}
